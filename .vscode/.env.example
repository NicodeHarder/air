# Copy to .vscode/.env and fill in.  (.vscode/.env is git-ignored.)
PYTHONUNBUFFERED=1
TOKENIZERS_PARALLELISM=false

# Hugging Face token (only needed for gated models such as meta-llama/*)
HF_TOKEN=your_huggingface_token_here

# Where compressed models / cached analysis (S, I) / results are written.
RESULTS_DIR=/absolute/path/to/results
